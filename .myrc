# My personal shell configuration

# PATH
# ---
export PATH="$HOME/.local/scripts:$PATH"

# Environment variables
# ---
export XDG_CONFIG_HOME="$HOME/.config"
# export XDG_DATA_HOME="$HOME/.local/share"
# export XDG_CACHE_HOME="$HOME/.cache"
# export XDG_STATE_HOME="$HOME/.local/state"

# Aliases
# ---
alias ll='ls -la'
alias ..='cd ..'
alias c='clear'
# alias h='history'
# alias v='vim'
alias nv='nvim .'
alias vim='nvim'
# alias g='git'
# alias ga='git add'
# alias gc='git commit'
# alias gp='git push'
# alias gl='git pull'
# alias gs='git status'
# alias gb='git branch'
# alias gd='git diff'
# alias gco='git checkout'
# alias gcm='git commit -m'

# Aliases for tmux
# ---
alias t='tmux'
alias tnss='tmux new-session -s'
alias tnwn='tmux new-window -n'
alias ta='tmux attach'
alias tast='tmux attach-session -t'
alias tls='tmux list-sessions'
alias tks='tmux kill-session'
alias tkst='tmux kill-session -t'
alias tkw='tmux kill-window'
alias tkwt='tmux kill-window -t'
alias tsct='tmux switch-client -t'

# Aliases for common tasks
# ---
# alias install='brew install'
alias srczsh='source "$HOME/.zshrc"'
alias srczp='source "$HOME/.zprofile"'

# Aliases for navigation
# ---
alias home='cd ~/'
# alias config='cd "$XDG_CONFIG_HOME"'
# alias local='cd "$HOME/.local"'
# alias cache='cd "$XDG_CACHE_HOME"'
# alias data='cd "$XDG_DATA_HOME"'

# Aliases for development
# ---
alias work='cd ~/workspaces'
alias ghcs='gh copilot suggest'
alias ghce='gh copilot explain'
